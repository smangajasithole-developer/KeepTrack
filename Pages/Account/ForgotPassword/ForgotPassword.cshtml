@page "/Account/ForgotPassword"
@model keeptrack.Pages.Account.ForgotPassword.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/forgotpassword.css"
          asp-append-version="true" />
}

<div class="forgot-password-page">

    <div class="forgot-password-card">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="forgot-password-header">
            <span class="forgot-password-eyebrow">KEEPTRACK</span>

            <h1>Reset your password</h1>

            <p>
                Recover access to your account by following the steps below.
            </p>
        </div>


        <!-- =====================================================
             STATUS MESSAGE
             ===================================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="forgot-password-status" role="status">
                @Model.StatusMessage
            </div>
        }


        <!-- =====================================================
             24-HOUR LOCKOUT COUNTDOWN
             ===================================================== -->

        @if (Model.LockoutExpiresAtUnix.HasValue)
        {
            <div class="forgot-password-countdown is-expired"
                 id="forgot-password-lockout-countdown"
                 data-expiry-unix="@Model.LockoutExpiresAtUnix.Value">

                <span class="forgot-password-countdown-label">
                    You can request another code in
                </span>

                <span class="forgot-password-countdown-time"
                      id="forgot-password-lockout-countdown-time"
                      role="timer"
                      aria-live="off">
                    24:00:00
                </span>
            </div>

            <p class="forgot-password-expired-message"
               id="forgot-password-lockout-finished-message"
               role="status"
               hidden>
                Your waiting period has ended. You can request a new reset code.
            </p>
        }


        <!-- =====================================================
             STEP 1: REQUEST RESET CODE
             ===================================================== -->

        @if (!Model.CodeSent)
        {
            <form method="post"
                  asp-page-handler="SendCode"
                  class="forgot-password-form"
                  id="send-code-form">

                <div asp-validation-summary="ModelOnly"
                     class="forgot-password-validation-summary"></div>

                <div class="forgot-password-section">

                    <div class="forgot-password-section-heading">
                        <h2>Account Information</h2>

                        <p>
                            Enter the email address associated with your account.
                        </p>
                    </div>

                    <div class="forgot-password-form-group">
                        <label asp-for="Input.Email">Email Address</label>

                        <input asp-for="Input.Email"
                               class="forgot-password-input"
                               id="forgot-password-email"
                               type="email"
                               placeholder="Enter your email address"
                               autocomplete="email" />

                        <span asp-validation-for="Input.Email"
                              class="forgot-password-validation-message"></span>
                    </div>

                </div>

                <button type="submit"
                        class="forgot-password-primary-button"
                        id="send-code-button"
                        data-submitting="Sending..."
                        disabled="@(!Model.CanRequestCode)">
                    Send Reset Code
                </button>

            </form>
        }


        <!-- =====================================================
             STEP 2: VERIFY RESET CODE
             ===================================================== -->

        @if (Model.CodeSent && !Model.CodeVerified)
        {
            <form method="post"
                  asp-page-handler="VerifyCode"
                  class="forgot-password-form"
                  id="verify-code-form">

                <input type="hidden" asp-for="Input.Email" />

                <div asp-validation-summary="ModelOnly"
                     class="forgot-password-validation-summary"></div>

                <div class="forgot-password-section">

                    <div class="forgot-password-section-heading">
                        <h2>Verify Your Email</h2>

                        <p>
                            If an account matches that email address, a six-digit
                            reset code has been sent. Check your inbox and spam folder.
                        </p>

                        @if (Model.CodeExpiresAtUnix.HasValue)
                        {
                            <div class="forgot-password-countdown"
                                 id="forgot-password-countdown"
                                 data-expiry-unix="@Model.CodeExpiresAtUnix.Value">

                                <span class="forgot-password-countdown-label">
                                    Your code expires in
                                </span>

                                <span class="forgot-password-countdown-time"
                                      id="forgot-password-countdown-time"
                                      role="timer"
                                      aria-live="off">
                                    01:00
                                </span>
                            </div>

                            <p class="forgot-password-expired-message"
                               id="forgot-password-expired-message"
                               role="status"
                               hidden>
                                Your code has expired. Request a new code to continue.
                            </p>
                        }
                    </div>

                    <div class="forgot-password-form-group">
                        <label asp-for="Input.Code">Verification Code</label>

                        <input asp-for="Input.Code"
                               class="forgot-password-input"
                               type="text"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="Enter your six-digit code" />

                        <span asp-validation-for="Input.Code"
                              class="forgot-password-validation-message"></span>
                    </div>

                </div>

                <button type="submit"
                        class="forgot-password-primary-button"
                        id="verify-code-button"
                        data-submitting="Verifying...">
                    Verify Code
                </button>

            </form>

            @if (Model.CanResendCode)
            {
                <!-- ---------- Resend Reset Code ---------- -->

                <form method="post"
                      asp-page-handler="ResendCode"
                      class="forgot-password-resend-form"
                      id="resend-code-form">

                    <input type="hidden" asp-for="Input.Email" />

                    <button type="submit"
                            class="forgot-password-secondary-button"
                            id="resend-code-button"
                            data-submitting="Resending...">
                        Resend Code
                    </button>

                </form>
            }
            else if (!Model.CanRequestCode)
            {
                <p class="forgot-password-expired-message">
                    You have used all 3 code requests. Wait for the 24-hour countdown
                    to finish before requesting another code.
                </p>

                <div class="forgot-password-footer">
                    <a asp-page="/Account/ForgotPassword">
                        Start a new request
                    </a>
                </div>
            }
        }


        <!-- =====================================================
             STEP 3: SET NEW PASSWORD
             ===================================================== -->

        @if (Model.CodeVerified)
        {
            <form method="post"
                  asp-page-handler="ResetPassword"
                  class="forgot-password-form"
                  id="reset-password-form">

                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Code" />

                <div asp-validation-summary="ModelOnly"
                     class="forgot-password-validation-summary"></div>

                <div class="forgot-password-section">

                    <div class="forgot-password-section-heading">
                        <h2>Create a New Password</h2>

                        <p>
                            Choose a new password for your KeepTrack account.
                        </p>
                    </div>

                    <div class="forgot-password-form-group">
                        <label asp-for="Input.NewPassword">New Password</label>

                        <input asp-for="Input.NewPassword"
                               class="forgot-password-input"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Enter your new password" />

                        <span asp-validation-for="Input.NewPassword"
                              class="forgot-password-validation-message"></span>
                    </div>

                    <div class="forgot-password-form-group">
                        <label asp-for="Input.ConfirmPassword">Confirm New Password</label>

                        <input asp-for="Input.ConfirmPassword"
                               class="forgot-password-input"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Confirm your new password" />

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="forgot-password-validation-message"></span>
                    </div>

                </div>

                <button type="submit"
                        class="forgot-password-primary-button"
                        id="reset-password-button"
                        data-submitting="Resetting...">
                    Reset Password
                </button>

            </form>
        }


        <!-- =====================================================
             FOOTER — BACK TO SIGN IN
             ===================================================== -->

        <div class="forgot-password-footer">
            <a asp-page="/Account/SignIn/SignIn">
                Back to Sign In
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/forgotpassword.js"
            asp-append-version="true"></script>
}